diff --git a/src/launcher/handheld_main.cpp b/src/launcher/handheld_main.cpp
new file mode 100644
index 00000000..03247853
--- /dev/null
+++ b/src/launcher/handheld_main.cpp
@@ -0,0 +1,48 @@
+// Handheld entry point (MSCHARGED_HANDHELD=ON): starts the original game runtime directly with the launch
+// settings (--config, --disc, --fullscreen, --size, ...). There is no launcher UI, settings editor or disc picker;
+// the PortMaster script supplies the disc and the settings file.
+#include <SDL3/SDL_main.h>
+
+#include "bootstrap/launch_options.h"
+#include "mscharged/build_version.h"
+#include "platform/session_log.h"
+#include "runtime/original_main_credits.h"
+
+#include <exception>
+#include <iostream>
+#include <string>
+
+int main(int argc, char** argv)
+{
+    using namespace mscharged;
+    try
+    {
+        LaunchOptions options;
+        for (int i = 1; i < argc; ++i)
+        {
+            if (ParseLaunchOption(argc, argv, i, options)) continue;
+            const std::string arg = argv[i];
+            if (arg == "--version")
+            {
+                std::cout << "mscharged " << build::version << " (" << MSCHARGED_BUILD_CONFIG << "; handheld)\n";
+                return 0;
+            }
+            if (arg == "--help")
+            {
+                std::cout << "Usage: mscharged [launch settings] [--version]\n" << LaunchOptionsHelp
+                          << "Handheld build: the game starts directly, there is no launcher.\n";
+                return 0;
+            }
+            std::cerr << "Unknown or incomplete argument: " << arg << ". Use --help.\n";
+            return 2;
+        }
+        platform::StartSessionLog(build::version, argc, argv);
+        const std::string title = std::string("MSCharged Port ") + build::version;
+        return RunOriginalMainCredits(argc, argv, nullptr, false, OriginalMainScene::FrontendSequence, title.c_str());
+    }
+    catch (const std::exception& error)
+    {
+        platform::ReportFatalError(std::string("Startup failed: ") + error.what());
+        return 1;
+    }
+}
