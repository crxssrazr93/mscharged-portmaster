diff --git a/lib/imgui_none.cpp b/lib/imgui_none.cpp
new file mode 100644
index 0000000..9e7edaa
--- /dev/null
+++ b/lib/imgui_none.cpp
@@ -0,0 +1,14 @@
+// AURORA_LEAN: no Dear ImGui overlay. The overlay is a development aid; the game never draws through it.
+// Same interface as imgui.cpp, every call does nothing, so the frame loop and the window code are unchanged.
+#include "imgui.hpp"
+
+namespace aurora::imgui {
+void create_context() noexcept {}
+void initialize() noexcept {}
+void shutdown() noexcept {}
+void process_event(const SDL_Event&) noexcept {}
+void set_cursor_managed(bool) noexcept {}
+void new_frame(const AuroraWindowSize&) noexcept {}
+DrawData freeze() noexcept { return {}; }
+void render(gl::PassEncoder&, const DrawData&) noexcept {}
+} // namespace aurora::imgui
