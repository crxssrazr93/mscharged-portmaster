 // Persistent caches for CPU-expanded native-fetch geometry. Separate from the per-frame staging rings
 // so cached ranges can never be clobbered by ring uploads. Filled once per unique mesh (by content
 // hash) and referenced every subsequent frame.
-constexpr uint64_t NativeGeomVertexCacheSize = 24ull * 1024 * 1024;
-constexpr uint64_t NativeGeomIndexCacheSize = 4ull * 1024 * 1024;
+// Sized from the measured peaks (menus and a match use under 4 MB of vertices); a full cache is recycled at the next
+// frame boundary, so a too small cache only costs re-uploads. AURORA_NATIVE_VERTEX_CACHE_MB / _INDEX_CACHE_MB override.
+uint64_t env_mb(const char* name, uint64_t defaultMb) {
+  const char* env = std::getenv(name);
+  const long v = env != nullptr ? std::atol(env) : 0;
+  return (v > 0 ? static_cast<uint64_t>(v) : defaultMb) * 1024ull * 1024ull;
+}
+const uint64_t NativeGeomVertexCacheSize = env_mb("AURORA_NATIVE_VERTEX_CACHE_MB", 12);
+const uint64_t NativeGeomIndexCacheSize = env_mb("AURORA_NATIVE_INDEX_CACHE_MB", 2);
+
+std::atomic<uint64_t> g_vertexRing{env_mb("AURORA_VERTEX_RING_MB", 8)};
+std::atomic<uint64_t> g_uniformRing{env_mb("AURORA_UNIFORM_RING_MB", 6)};
+std::atomic<uint64_t> g_indexRing{env_mb("AURORA_INDEX_RING_MB", 2)};
+
+std::atomic<uint64_t> g_ringGrowTo[4]; // by RingKind: bytes the ring should have from the next frame on (0 = none)
+
+// Rings that a recorded frame overran (ring_note_overflow) are larger from the next frame on. Recording thread.
+void apply_ring_growth() {
+  struct Ring { std::atomic<uint64_t>* size; RingKind kind; uint64_t reserve; const char* name; };
+  const Ring rings[] = {{&g_vertexRing, RingKind::Vertex, VertexBufferReserve, "vertex"},
+                        {&g_uniformRing, RingKind::Uniform, UniformBufferReserve, "uniform"},
+                        {&g_indexRing, RingKind::Index, IndexBufferReserve, "index"}};
+  for (const auto& r : rings) {
+    const uint64_t want = std::min(g_ringGrowTo[static_cast<size_t>(r.kind)].exchange(0), r.reserve);
+    if (want > r.size->load()) {
+      Log.warn("[gl] {} ring grows {} -> {} MiB after an overrun", r.name, r.size->load() >> 20, want >> 20);
+      r.size->store(want);
+    }
+  }
+}
+
+// Worker: recreate this slot's GL ring buffers when the ring sizes changed (after the slot's fence, so the GPU is
+// done with them; deleting a buffer is deferred by the driver anyway).
+void ensure_slot_buffers(size_t slot) {
+  auto& set = g_frameBufferSets[slot];
+  bool changed = false;
+  const auto redo = [&](gl::Buffer& buf, gl::GLenum target, uint64_t size) {
+    if (buf.id != 0 && buf.size == size) {
+      return;
+    }
+    gl::Buffer fresh = gl::create_buffer(target, size, true, /*persistent=*/true);
+    gl::destroy_buffer(buf);
+    buf = fresh;
+    changed = true;
+  };
+  redo(set.vertex, gl::GL_ARRAY_BUFFER, vertex_ring_bytes());
+  redo(set.uniform, gl::GL_UNIFORM_BUFFER, uniform_ring_bytes());
+  redo(set.index, gl::GL_ELEMENT_ARRAY_BUFFER, index_ring_bytes());
+  if (changed) {
+    gl::reset_state_cache();
+  }
+}
+
+
 // Bump-allocator cursors; on exhaustion the whole cache is reset (deferred to a frame boundary). The
 // generation counter bumps on each reset so CPU-side content maps can drop entries that point at
 // now-recycled ranges. Recording thread only.
@@ -245,9 +299,21 @@ size_t acquire_frame_slot() {
