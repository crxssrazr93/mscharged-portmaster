+// The audio clock: the hardware side of the AI DMA on its own thread and timer. It moves the DMA position with the
+// nominal sample clock and the lead, copies each completed 96 frame block into the SDL queue, latches the next
+// registers as soon as the owner has programmed them (AIInitDMA wakes it) and raises the AID cause. The owner takes the
+// cause at its next safe point and runs the original callback there; a slow or blocked game thread therefore only
+// delays the callbacks, never the transfer of what is already programmed or the SDL queue.
+void ClockMain(AIState* sp) {
+    auto& state = *sp;
+    SDL_SetCurrentThreadPriority(SDL_THREAD_PRIORITY_HIGH);
+    std::unique_lock lock(state.clock_mutex);
+    while (!state.clock_stop.load()) {
+        state.clock_cv.wait_for(lock, std::chrono::milliseconds(2));
+        if (state.clock_stop.load()) break;
+        lock.unlock();
+        SDL_AudioStream* stream;
+        bool active;
+        {
+            std::lock_guard guard(state.mutex);
+            stream = state.stream;
+            active = state.initialized && state.running;
+        }
+        if (stream && active) Transfer(state, stream);
+        if (stream) StatsTick(state, stream);
+        lock.lock();
+    }
+}
+
+void StopClock(AIState& state) {
+    if (!state.clock.joinable()) return;
+    { std::lock_guard lock(state.clock_mutex); state.clock_stop.store(true); }
+    state.clock_cv.notify_all();
+    state.clock.join();
+    state.clock_id = {};
+}
