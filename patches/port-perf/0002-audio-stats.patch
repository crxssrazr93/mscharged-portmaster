diff --git a/src/platform/audio_stats.h b/src/platform/audio_stats.h
new file mode 100644
index 00000000..c7cd0afa
--- /dev/null
+++ b/src/platform/audio_stats.h
@@ -0,0 +1,23 @@
+#pragma once
+// Env-gated (MSCHARGED_AUDIOSTATS=1) audio delivery counters: one "[audiostats]" line per second on stderr, printed by
+// platform/ai.cpp. The AX part is filled by the functional AX device. Counting is cheap (relaxed atomics) and only
+// done when the switch is on.
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+
+namespace mscharged::platform {
+struct AudioStatCounters {
+    // AX frame jobs: count, longest compute on the worker, total owner commit delay (job done until the owner commits).
+    std::atomic<std::uint64_t> ax_jobs{}, ax_compute_max_ns{}, ax_commit_delay_sum_ns{}, ax_commit_delay_max_ns{};
+};
+inline AudioStatCounters g_audio_stats;
+inline const bool g_audio_stats_on = [] {
+    const char* v = std::getenv("MSCHARGED_AUDIOSTATS");
+    return v && *v && *v != '0';
+}();
+inline void AudioStatMax(std::atomic<std::uint64_t>& slot, std::uint64_t value) {
+    auto old = slot.load(std::memory_order_relaxed);
+    while (value > old && !slot.compare_exchange_weak(old, value, std::memory_order_relaxed)) {}
+}
+} // namespace mscharged::platform
