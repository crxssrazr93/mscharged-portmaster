+// MSCHARGED_AUDIOSTATS=1: one line per second. Called from the SDL device thread (after every pull) and from the owner's
+// service, whichever comes first once the second is over.
+void StatsTick(AIState& state, SDL_AudioStream* stream) {
+    if (!mscharged::platform::g_audio_stats_on || !stream) return;
+    using mscharged::platform::g_audio_stats;
+    const auto now = SDL_GetTicksNS();
+    AIState::Window w;
+    std::uint64_t dt;
+    int rate;
+    bool running;
+    {
+        std::lock_guard lock(state.mutex);
+        if (!state.stats_window_start_ns) { state.stats_window_start_ns = now; return; }
+        dt = now - state.stats_window_start_ns;
+        if (dt < 1000000000ull) return;
+        state.stats_window_start_ns = now;
+        w = state.win;
+        state.win = {};
+        rate = Frequency(state.rate);
+        running = state.running;
+    }
+    const int queued_now = SDL_GetAudioStreamQueued(stream);
+    const double bytes_per_ms = double(rate) * 4.0 / 1000.0;
+    const double qmin = w.queue_samples ? double(w.queue_min) / bytes_per_ms : -1.0;
+    const double qavg = w.queue_samples ? double(w.queue_sum) / double(w.queue_samples) / bytes_per_ms : -1.0;
+    const auto ax_jobs = g_audio_stats.ax_jobs.exchange(0, std::memory_order_relaxed);
+    const auto ax_comp = g_audio_stats.ax_compute_max_ns.exchange(0, std::memory_order_relaxed);
+    const auto ax_dsum = g_audio_stats.ax_commit_delay_sum_ns.exchange(0, std::memory_order_relaxed);
+    const auto ax_dmax = g_audio_stats.ax_commit_delay_max_ns.exchange(0, std::memory_order_relaxed);
+    std::fprintf(stderr,
+        "[audiostats] dt=%.2fs run=%d queue_ms min=%.1f avg=%.1f now=%.1f pulls=%llu underruns=%llu silence_ms=%.1f "
+        "blocks=%llu held=%llu held_ms_max=%.1f late_blocks=%llu cb_lat_ms avg=%.1f max=%.1f skipped_blocks=%.1f "
+        "replayed=%llu dup=%llu nosrc=%llu ax_jobs=%llu ax_compute_ms_max=%.2f ax_commit_delay_ms avg=%.2f max=%.2f\n",
+        double(dt) / 1e9, running ? 1 : 0, qmin, qavg, double(queued_now) / bytes_per_ms,
+        (unsigned long long)w.pulls, (unsigned long long)w.short_pulls, double(w.short_bytes) / bytes_per_ms,
+        (unsigned long long)w.blocks, (unsigned long long)w.held, double(w.held_max_ns) / 1e6,
+        (unsigned long long)w.late_cb, w.dispatched ? double(w.lat_sum_ns) / double(w.dispatched) / 1e6 : 0.0,
+        double(w.lat_max_ns) / 1e6, double(w.skipped_cells) / 12.0, (unsigned long long)w.replayed,
+        (unsigned long long)w.dup, (unsigned long long)w.nosrc, (unsigned long long)ax_jobs, double(ax_comp) / 1e6,
+        ax_jobs ? double(ax_dsum) / double(ax_jobs) / 1e6 : 0.0, double(ax_dmax) / 1e6);
+    std::fflush(stderr);
+}
