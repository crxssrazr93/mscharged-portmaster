+void FrameTimingLog::PerfAccumulate(const FrameTimingRecord& record)
+{
+    if (perf_frames_ == 0) perf_window_start_ns_ = record.start_ns;
+    ++perf_frames_;
+    perf_presents_ += record.presents;
+    perf_vi_ += record.vi_fields;
+    perf_sum_ns_ += record.duration_ns;
+    perf_game_sum_ns_ += record.game_ns;
+    if (record.duration_ns > perf_max_ns_) perf_max_ns_ = record.duration_ns;
+    const std::int64_t elapsed = record.start_ns + record.duration_ns - perf_window_start_ns_;
+    if (elapsed < 1000000000) return;
+    const double seconds = static_cast<double>(elapsed) / 1e9;
+    std::fprintf(stderr,
+                 "[perf] fps=%.1f frame_ms_avg=%.2f frame_ms_max=%.2f game_ms_avg=%.2f presents_per_s=%.1f "
+                 "vi_per_s=%.1f frames=%" PRIu64 "\n",
+                 perf_frames_ / seconds, Ms(perf_sum_ns_) / perf_frames_, Ms(perf_max_ns_),
+                 Ms(perf_game_sum_ns_) / perf_frames_, perf_presents_ / seconds, perf_vi_ / seconds, record.index + 1);
+    std::fflush(stderr);
+    perf_frames_ = perf_presents_ = perf_vi_ = 0;
+    perf_sum_ns_ = perf_max_ns_ = perf_game_sum_ns_ = 0;
+}
+
 void FrameTimingLog::Add(const FrameTimingRecord& record)
 {
+    if (perf_) {
+        PerfAccumulate(record);
+        return;
+    }
     if (records_.size() < kMaxRecords) records_.push_back(record);
     if (!file_) return;
     const std::int64_t origin = records_.empty() ? record.start_ns : records_.front().start_ns;
