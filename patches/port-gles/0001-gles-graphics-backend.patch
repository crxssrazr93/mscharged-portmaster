+# Graphics backend: "vulkan" (Dawn/WebGPU, the default and unchanged) or "gles"
+# (Aurora rebuilt on OpenGL ES 3 from the extra patch series; no Dawn).
+set(MSCHARGED_GRAPHICS_BACKEND "vulkan" CACHE STRING "Graphics backend: vulkan or gles")
+set_property(CACHE MSCHARGED_GRAPHICS_BACKEND PROPERTY STRINGS vulkan gles)
+if(NOT MSCHARGED_GRAPHICS_BACKEND MATCHES "^(vulkan|gles)$")
+    message(FATAL_ERROR "MSCHARGED_GRAPHICS_BACKEND must be vulkan or gles")
+endif()
+set(MSCHARGED_GLES OFF)
+if(MSCHARGED_GRAPHICS_BACKEND STREQUAL "gles")
+    if(APPLE)
+        message(FATAL_ERROR "The GLES graphics backend is not supported on macOS (use vulkan, which selects Metal)")
+    endif()
+    set(MSCHARGED_GLES ON)
+    # Extra Aurora patch series applied after patches/aurora (the GLES Aurora).
+    # Defaults to patches/aurora-gles in this checkout, else the one next to it.
+    if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/patches/aurora-gles")
+        set(MSCHARGED_AURORA_EXTRA_PATCH_DIR_DEFAULT "${CMAKE_CURRENT_SOURCE_DIR}/patches/aurora-gles")
+    else()
+        set(MSCHARGED_AURORA_EXTRA_PATCH_DIR_DEFAULT "${CMAKE_CURRENT_SOURCE_DIR}/../patches/aurora-gles")
+    endif()
+    set(MSCHARGED_AURORA_EXTRA_PATCH_DIR "${MSCHARGED_AURORA_EXTRA_PATCH_DIR_DEFAULT}" CACHE PATH
+        "Directory with the extra Aurora patch series (series file) applied after patches/aurora")
+    if(NOT EXISTS "${MSCHARGED_AURORA_EXTRA_PATCH_DIR}/series")
+        message(FATAL_ERROR "GLES graphics backend: ${MSCHARGED_AURORA_EXTRA_PATCH_DIR}/series not found. "
+            "Set MSCHARGED_AURORA_EXTRA_PATCH_DIR to the GLES Aurora patch series.")
+    endif()
+    # Selects the OpenGLES AuroraBackend (src/platform/graphics_backend.h) and
+    # compiles the GL readback paths instead of the WebGPU ones.
+    add_compile_definitions(MSCHARGED_GRAPHICS_GLES=1)
+    message(STATUS "Graphics backend: GLES (Aurora extra patches: ${MSCHARGED_AURORA_EXTRA_PATCH_DIR})")
+endif()
