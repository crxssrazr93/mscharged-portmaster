new file mode 100755
index 0000000000000000000000000000000000000000..cd46d6635134c53934e879711e12796782069ea7
--- /dev/null
+++ b/tools/prepare_gles_sources.py
@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+"""prepare_sources.py plus an extra Aurora patch series for the GLES graphics backend.
+
+Takes the same arguments as prepare_sources.py and one more,
+--aurora-extra-patch-dir DIR (or the AURORA_EXTRA_PATCH_DIR environment variable).
+The series in DIR (a `series` file listing patches, one per line; an optional `base`
+file must match the pinned Aurora commit) is applied after patches/aurora and its
+optional tweaks series. Other dependencies are prepared exactly as before.
+prepare_sources.py itself is not modified."""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import sys
+
+import prepare_sources as base
+
+
+def extract_extra_dir(argv: list[str]) -> tuple[list[str], Path | None]:
+    rest, directory, index = [], os.environ.get("AURORA_EXTRA_PATCH_DIR"), 0
+    while index < len(argv):
+        argument = argv[index]
+        if argument == "--aurora-extra-patch-dir":
+            if index + 1 >= len(argv):
+                raise SystemExit("--aurora-extra-patch-dir requires a directory")
+            directory = argv[index + 1]
+            index += 2
+        elif argument.startswith("--aurora-extra-patch-dir="):
+            directory = argument.split("=", 1)[1]
+            index += 1
+        else:
+            rest.append(argument)
+            index += 1
+    return rest, Path(directory).resolve() if directory else None
+
+
+def extra_series(directory: Path, commit: str):
+    if not (directory / "series").is_file():
+        raise base.PreparationError(f"No series file in the extra Aurora patch directory: {directory}")
+    base_file = directory / "base"
+    if base_file.is_file():
+        # The GLES series sits on the Charged patches, so its base is the same pin.
+        recorded = base_file.read_text().strip()
+        if recorded != commit:
+            raise base.PreparationError(
+                f"Patch base for {directory.name} is {recorded}; selected pin is {commit}. Refresh the series explicitly.")
+        patches, series_sha = base.series_inputs(directory, directory.name, commit, prefix=f"{directory.name}/")
+    else:
+        # series_inputs insists on a base file; without one the series is taken to sit on the pin.
+        series = (directory / "series").read_bytes()
+        patches = []
+        for line in series.decode().splitlines():
+            name = line.strip()
+            if not name or name.startswith("#"):
+                continue
+            path = base.safe_child(directory, name)
+            full = f"{directory.name}/{name}"
+            if any(p["name"] == full for p in patches):
+                raise base.PreparationError(f"Duplicate patch in series: {name}")
+            patches.append({"name": full, "sha256": base.sha(path.read_bytes()), "file": path})
+        series_sha = base.sha(series)
+    return patches, series_sha
+
+
+def install(directory: Path) -> None:
+    original = base.patch_inputs
+
+    def patch_inputs(root: Path, name: str, commit: str):
+        patches, series_sha = original(root, name, commit)
+        if name != "aurora":
+            return patches, series_sha
+        extra, extra_sha = extra_series(directory, commit)
+        return patches + extra, base.sha(base.encoded([series_sha, extra_sha]))
+
+    base.patch_inputs = patch_inputs
+
+
+def main() -> None:
+    argv, directory = extract_extra_dir(sys.argv[1:])
+    if directory is not None:
+        install(directory)
+    sys.argv = [sys.argv[0], *argv]
+    base.main()
+
+
+if __name__ == "__main__":
+    if sys.version_info < (3, 10):
+        raise SystemExit("Source preparation requires Python 3.10 or newer")
+    main()
