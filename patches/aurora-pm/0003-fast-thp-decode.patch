+namespace {
+// Optional (MSCHARGED_THPSTATS=1) one line per second on stderr: frames, ms per frame, input MB/s.
+struct ThpStats {
+  std::atomic<u64> frames{}, ns{}, serviceNs{}, bytes{}, failures{};
+  std::atomic<u64> lastPrint{};
+};
+ThpStats g_thpStats;
+const bool g_thpStatsOn = [] {
+  const char* v = std::getenv("MSCHARGED_THPSTATS");
+  return v != nullptr && *v != '\0' && *v != '0';
+}();
+u64 now_ns() noexcept {
+  return static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                              std::chrono::steady_clock::now().time_since_epoch())
+                              .count());
+}
+void stats_tick(u64 now) noexcept {
+  u64 last = g_thpStats.lastPrint.load(std::memory_order_relaxed);
+  if (last == 0) {
+    g_thpStats.lastPrint.store(now, std::memory_order_relaxed);
+    return;
+  }
+  if (now - last < 1000000000ull ||
+      !g_thpStats.lastPrint.compare_exchange_strong(last, now, std::memory_order_relaxed)) {
+    return;
+  }
+  const u64 frames = g_thpStats.frames.exchange(0);
+  const u64 ns = g_thpStats.ns.exchange(0);
+  const u64 serviceNs = g_thpStats.serviceNs.exchange(0);
+  const u64 bytes = g_thpStats.bytes.exchange(0);
+  const u64 failures = g_thpStats.failures.exchange(0);
+  const double dt = static_cast<double>(now - last) / 1e9;
+  if (frames != 0) {
+    std::fprintf(stderr,
+                 "[thpstats] dt=%.2fs frames=%llu ms_per_frame=%.3f decode_ms_per_frame=%.3f service_ms_per_frame=%.3f "
+                 "in_MB_s=%.2f failures=%llu\n",
+                 dt, static_cast<unsigned long long>(frames), static_cast<double>(ns) / 1e6 / static_cast<double>(frames),
+                 static_cast<double>(ns - serviceNs) / 1e6 / static_cast<double>(frames),
+                 static_cast<double>(serviceNs) / 1e6 / static_cast<double>(frames),
+                 static_cast<double>(bytes) / 1e6 / dt, static_cast<unsigned long long>(failures));
+  }
+}
