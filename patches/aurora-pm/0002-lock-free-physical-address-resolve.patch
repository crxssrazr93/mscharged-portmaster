+constexpr unsigned FastRegionMax = 16;
+struct FastRegion { std::atomic<u64> start{}, reserved{}, address{}, bytes{}; std::atomic<bool> active{}; };
+struct FastMap {
+    std::atomic<u64> seq{0};
+    std::atomic<u32> count{0};
