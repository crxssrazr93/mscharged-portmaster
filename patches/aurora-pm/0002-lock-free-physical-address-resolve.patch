+        r.reserved.store(entry.reserved, std::memory_order_relaxed);
+        r.address.store(entry.address, std::memory_order_relaxed);
+        r.bytes.store(entry.bytes, std::memory_order_relaxed);
+        r.active.store(entry.active, std::memory_order_relaxed);
+    }
+    g_fast.count.store(n, std::memory_order_relaxed);
+    g_fast.overflow.store(state.regions.size() > FastRegionMax, std::memory_order_relaxed);
+    g_fast.seq.store(seq + 2, std::memory_order_release);
