+void OSTicksToCalendarTime(OSTime ticks, OSCalendarTime* td) {
+  // Input ticks are UTC relative to the GCN epoch; break them up in local time.
+  const int64_t micros = OSTicksToMicroseconds(ticks) + 946684800LL * 1000000LL;
+  int64_t seconds = micros / 1000000;
+  int64_t fraction = micros % 1000000;
+  if (fraction < 0) {
+    fraction += 1000000;
+    --seconds;
+  }
+  const std::time_t wallClock = static_cast<std::time_t>(seconds);
+  std::tm localTm{};
+  const std::tm* result = localtime_r(&wallClock, &localTm);
+  AURORA_ASSERT(result != nullptr, "localtime_r failed in OSTicksToCalendarTime");
