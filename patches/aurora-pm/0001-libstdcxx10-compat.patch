+  localTm.tm_mday = td->mday;
+  localTm.tm_mon = td->mon;
+  localTm.tm_year = td->year - 1900;
+  localTm.tm_isdst = -1;
+  const std::time_t utcTime = mktime(&localTm);
+  AURORA_ASSERT(utcTime != -1, "mktime failed in OSCalendarTimeToTicks");
+  const int64_t micros = static_cast<int64_t>(utcTime) * 1000000LL + td->msec * 1000LL + td->usec -
+                         946684800LL * 1000000LL;
+  return OSMicrosecondsToTicks(micros);
+}
