From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sajid Ahamed <crxssrazr93@gmail.com>
Date: Tue, 13 Oct 2026 16:25:11 +0530
Subject: [PATCH] dbg

---
 lib/gx/texture.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/lib/gx/texture.cpp b/lib/gx/texture.cpp
index 2e5bfe4..c60e8e7 100644
--- a/lib/gx/texture.cpp
+++ b/lib/gx/texture.cpp
@@ -610,6 +610,13 @@ void invalidate_replacement(uint64_t replacementId) noexcept {
 // per frame at most, so objects reused for many textures within a frame never qualify), it gets one private
 // texture that is refreshed in place. Returns that texture, or null for the normal path.
 gfx::TextureHandle try_streaming_update(const GXTexObj_& obj) {
+  static int dbg = 0;
+  if (dbg < 60 && obj.format() == GX_TF_I8) {
+    ++dbg;
+    Log.warn("[dbg] miss id {} {}x{} ver {} nocache {} hasdata {} cached {} frame {}", obj.texObjId, obj.width(),
+             obj.height(), obj.texDataVersion, obj.no_cache(), obj.has_data(),
+             s_textureObjectCaches.contains(obj.texObjId), s_frameCount);
+  }
   if (obj.texObjId == 0 || !obj.has_data() || is_palette_format(obj.format())) {
     return {};
   }
