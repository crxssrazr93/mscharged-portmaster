   resolve_pass_into_with_uniforms(snapshot->packedYuyv, rect,
       clear && state.colorUpdate, clear && state.alphaUpdate && gx::efb_has_alpha(state.pixelFmt),
       clear && state.depthUpdate, state.clearColor, gx::clear_depth_value(), ResolveFormat,
-      state.pixelFmt, &uniforms, sizeof(uniforms), [snapshot] { complete(snapshot); });
+      state.pixelFmt, &uniforms, sizeof(uniforms), {});
+  // Complete as soon as the copy is recorded: the VI scanout work that reads it is queued later on the render worker.
+  complete(snapshot);
 }
 
 void set_flicker_filter(bool enabled) { g_flickerFilter.store(enabled, std::memory_order_relaxed); }
