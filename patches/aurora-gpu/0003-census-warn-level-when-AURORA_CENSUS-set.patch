From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sajid Ahamed <crxssrazr93@gmail.com>
Date: Tue, 13 Oct 2026 15:48:35 +0530
Subject: [PATCH] census: warn level when AURORA_CENSUS set

---
 lib/gl/census.cpp | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/lib/gl/census.cpp b/lib/gl/census.cpp
index d53d31c..6694a7b 100644
--- a/lib/gl/census.cpp
+++ b/lib/gl/census.cpp
@@ -180,8 +180,7 @@ void log_tick() noexcept {
   const int64_t binN = s_progBinary.load(std::memory_order_relaxed);
   const Mem mem = read_mem();
   // Warning level when explicitly requested: the port runs Aurora at LOG_WARNING.
-  const auto emit = [&](auto&&... a) { detailed > 0 ? Log.warn(a...) : Log.info(a...); };
-  emit("[gl-census] t={} tex {} ({:.1f} MB, as RGBA8 {:.1f} MB, peak {:.1f} MB) rt {} ({:.1f} MB) depth {} ({:.1f} MB) "
+  std::string head = fmt::format("[gl-census] t={} tex {} ({:.1f} MB, as RGBA8 {:.1f} MB, peak {:.1f} MB) rt {} ({:.1f} MB) depth {} ({:.1f} MB) "
            "buf {} ({:.1f} MB) prog {} (source {} {:.0f} ms, binary {} {:.0f} ms, max {:.0f} ms) fbo {} smp {} "
            "rss {:.0f} MB swap {:.0f} MB hwm {:.0f} MB",
            t, textures.count.load(std::memory_order_relaxed), mb(textures), mb(equivAll),
@@ -193,6 +192,8 @@ void log_tick() noexcept {
            static_cast<double>(s_progMaxUs.load(std::memory_order_relaxed)) / 1000.0,
            fbos.count.load(std::memory_order_relaxed), samplers.count.load(std::memory_order_relaxed), mem.rss, mem.swap,
            mem.hwm);
+  const auto emit = [&](const std::string& m) { detailed > 0 ? Log.warn("{}", m) : Log.info("{}", m); };
+  emit(head);
   if (detailed > 0) {
     std::string line;
     for (int i = 0; i < TagCount; ++i) {
@@ -204,7 +205,7 @@ void log_tick() noexcept {
                           mb(s_tags[i].bytes.load(std::memory_order_relaxed)),
                           mb(s_tags[i].equiv.load(std::memory_order_relaxed)));
     }
-    emit("[gl-census-fmt] t={} (count/MB/MB as RGBA8){}", t, line);
+    emit(fmt::format("[gl-census-fmt] t={} (count/MB/MB as RGBA8){}", t, line));
   }
 }
 
