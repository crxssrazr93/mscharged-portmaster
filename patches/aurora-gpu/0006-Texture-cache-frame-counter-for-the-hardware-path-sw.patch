 }
 
+TextureHandle new_streaming_texture_2d(uint32_t width, uint32_t height, uint32_t mips, u32 gxFormat,
+                                       const char* label) noexcept {
+  ZoneScopedS(3);
+  clamp_texture_dims(width, height, mips, label);
+  gl::TextureFormat glFormat = to_gl(gxFormat);
+  gl::TexSwizzle swizzle = gl::TexSwizzle::None;
+  if (compact_mode() != CompactMode::Off && glFormat == gl::TextureFormat::RGBA8Unorm) {
+    if (gxFormat == GX_TF_I4 || gxFormat == GX_TF_I8) {
+      glFormat = gl::TextureFormat::R8Unorm, swizzle = gl::TexSwizzle::RRRR;
+    } else if (gxFormat == GX_TF_IA4 || gxFormat == GX_TF_IA8) {
+      glFormat = gl::TextureFormat::RG8Unorm, swizzle = gl::TexSwizzle::RRRG;
+    }
+  }
+  const gl::Extent3D size{.width = width, .height = height, .depthOrArrayLayers = 1};
+  gl::Texture texture =
+      create_gl_texture(glFormat, size, mips, /*renderable=*/false, census_tag_for(gxFormat, false), swizzle);
+  auto handle = std::make_shared<TextureRef>(texture, texture, gl::Texture{}, size, glFormat, mips, gxFormat);
+  handle->streaming = true;
+  return handle;
+}
