 namespace texture {
 size_t texture_source_size(u32 format, u32 width, u32 height, u32 mipCount) noexcept {
   if (width == 0 || height == 0 || mipCount == 0) {
@@ -593,6 +605,69 @@ void invalidate_replacement(uint64_t replacementId) noexcept {
   }
 }
 
+// Data that changes every frame (THP video planes) must not pile up as one cached GL texture per frame. The game
+// makes a new texture object per frame for the same plane buffer, so planes are recognized by where their data
+// lives (address, size, format). Called when texture data is new to the content cache: after it missed on three
+// consecutive frames (one miss per frame at most, so a buffer reused for several textures within a frame never
+// qualifies), the plane gets one private texture that is refreshed in place. Returns that texture, or null for the
+// normal path.
+struct StreamKey {
+  const void* data = nullptr;
+  u32 width = 0, height = 0, format = 0, mips = 0;
+  bool operator==(const StreamKey&) const = default;
+  template <typename H>
+  friend H AbslHashValue(H h, const StreamKey& k) {
+    return H::combine(std::move(h), k.data, k.width, k.height, k.format, k.mips);
+  }
+};
+struct StreamSlot {
+  gfx::TextureHandle handle; // set once streaming
+  uint64_t lastChangeFrame = 0;
+  uint64_t lastUsedFrame = 0;
+  uint32_t streak = 0;
+};
+absl::flat_hash_map<StreamKey, StreamSlot> s_streamSlots;
+
+void sweep_stream_slots() {
+  for (auto it = s_streamSlots.begin(); it != s_streamSlots.end();) {
+    if (s_frameCount > it->second.lastUsedFrame && s_frameCount - it->second.lastUsedFrame > 120) {
+      s_streamSlots.erase(it++);
+    } else {
+      ++it;
+    }
+  }
+}
+
+gfx::TextureHandle try_streaming_update(const GXTexObj_& obj) {
+  if (!obj.has_data() || is_palette_format(obj.format()) || obj.width() == 0 || obj.height() == 0) {
+    return {};
+  }
+  const StreamKey key{obj.data, obj.width(), obj.height(), obj.format(), obj.mip_count()};
+  auto [it, inserted] = s_streamSlots.try_emplace(key);
+  auto& slot = it->second;
+  slot.lastUsedFrame = s_frameCount;
+  if (!slot.handle) {
+    if (!inserted && slot.lastChangeFrame == s_frameCount) {
+      slot.streak = 0; // the same buffer holding several textures within one frame: not video
+      return {};
+    }
+    slot.streak = (!inserted && s_frameCount - slot.lastChangeFrame <= 4) ? slot.streak + 1 : 1;
+    slot.lastChangeFrame = s_frameCount;
+    if (slot.streak < 3) {
+      return {};
+    }
+    Log.info("[texture] {}x{} format {} data at {} changes every frame: one private texture, updated in place",
+             obj.width(), obj.height(), obj.format(), obj.data);
+    slot.handle = gfx::new_streaming_texture_2d(obj.width(), obj.height(), obj.mip_count(), obj.format(),
+                                                "GX Streaming Texture");
+  }
+  const size_t sourceBytes = texture_source_size(obj.format(), obj.width(), obj.height(), obj.mip_count());
+  gfx::write_texture(*slot.handle, {static_cast<const uint8_t*>(obj.data), sourceBytes});
+  ++s_stats.streamingUpdates;
+  s_stats.uploadBytes += texture_handle_size(slot.handle);
+  return slot.handle;
+}
+
 gfx::TextureHandle resolve_static_texture(const GXTexObj_& obj) {
   ZoneScoped;
 
@@ -623,6 +698,16 @@ gfx::TextureHandle resolve_static_texture(const GXTexObj_& obj) {
     }
     handle = find_content_texture(keys->contentKey);
     if (!handle) {
+      handle = try_streaming_update(obj);
+      if (handle) {
+        // Private streaming texture: not shared, so it stays out of the content cache.
+        if (!obj.no_cache()) {
+          store_cached_texture(obj, handle, 0, 0, replacementId);
+        }
+        return handle;
+      }
+    }
+    if (!handle) {
 #if DEBUG
       const auto name = gfx::texture_replacement::build_texture_replacement_name(*keys->sourceKey);
       const auto nameStr = name.c_str();
@@ -723,6 +808,13 @@ void end_frame() noexcept {
   ++s_frameCount;
   apply_pending_invalidations();
   sweep_object_caches();
+  sweep_stream_slots();
+}
+
+void advance_frame() noexcept {
+  ++s_frameCount;
+  sweep_object_caches();
+  sweep_stream_slots();
 }
 
 void shutdown() noexcept {
@@ -733,7 +825,7 @@ void shutdown() noexcept {
   s_contentLru.clear();
   s_sourceKeyCache.clear();
   s_contentCacheBytes = 0;
-  s_contentCacheBudgetBytes = ContentCacheBudgetBytes;
+  s_contentCacheBudgetBytes = content_cache_budget_default();
   s_frameCount = 0;
   s_bindGeneration = 1;
   s_pendingInvalidations.store(0, std::memory_order_release);
