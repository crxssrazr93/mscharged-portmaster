+  // Storage narrower than the RGBA8 decode (streaming textures): keep the channels the swizzle reads.
+  ByteBuffer packed;
+  if (!converted.data.empty() &&
+      (ref.format == gl::TextureFormat::R8Unorm || ref.format == gl::TextureFormat::RG8Unorm)) {
+    const size_t texels = converted.data.size() / 4;
+    const bool two = ref.format == gl::TextureFormat::RG8Unorm;
+    packed = ByteBuffer(texels * (two ? 2 : 1));
+    const uint8_t* src = converted.data.data();
+    for (size_t i = 0; i < texels; ++i) {
+      if (two) {
+        packed.data()[i * 2] = src[i * 4];
+        packed.data()[i * 2 + 1] = src[i * 4 + 3];
+      } else {
+        packed.data()[i] = src[i * 4];
+      }
+    }
+    data = packed;
+  }
