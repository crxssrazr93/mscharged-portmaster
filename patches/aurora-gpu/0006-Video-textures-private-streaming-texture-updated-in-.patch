 size_t texture_source_size(u32 format, u32 width, u32 height, u32 mipCount) noexcept {
   if (width == 0 || height == 0 || mipCount == 0) {
@@ -593,6 +605,50 @@ void invalidate_replacement(uint64_t replacementId) noexcept {
   }
 }
 
+// Data that changes every frame (THP video planes) must not pile up as one cached GL texture per frame. Called when a
+// texture object's data is new to the content cache: after the object missed on three consecutive frames (one miss
+// per frame at most, so objects reused for many textures within a frame never qualify), it gets one private
+// texture that is refreshed in place. Returns that texture, or null for the normal path.
+gfx::TextureHandle try_streaming_update(const GXTexObj_& obj) {
+  if (obj.texObjId == 0 || !obj.has_data() || is_palette_format(obj.format())) {
+    return {};
+  }
+  const auto it = s_textureObjectCaches.find(obj.texObjId);
+  if (it == s_textureObjectCaches.end()) {
+    return {};
+  }
+  auto& entry = it->second;
+  const auto& h = entry.handle;
+  if (!h || entry.tlutObjId != 0 || entry.replacementId != 0 || h->gxFormat != obj.format() ||
+      h->size.width != std::max(obj.width(), 1u) || h->size.height != std::max(obj.height(), 1u)) {
+    entry.changeStreak = 0;
+    return {};
+  }
+  if (!h->streaming) {
+    if (entry.lastChangeFrame == s_frameCount) {
+      entry.changeStreak = 0; // several different textures through one object in one frame: not video
+      return {};
+    }
+    entry.changeStreak = (s_frameCount - entry.lastChangeFrame <= 4) ? entry.changeStreak + 1 : 1;
+    entry.lastChangeFrame = s_frameCount;
+    if (entry.changeStreak < 3) {
+      return {};
+    }
+  }
+  const size_t sourceBytes = texture_source_size(obj.format(), obj.width(), obj.height(), obj.mip_count());
+  const ArrayRef<uint8_t> source{static_cast<const uint8_t*>(obj.data), sourceBytes};
+  if (!h->streaming) {
+    Log.info("[texture] texture object {} ({}x{} format {}) changes every frame: one private texture, updated in place",
+             obj.texObjId, obj.width(), obj.height(), obj.format());
+    entry.handle = gfx::new_streaming_texture_2d(obj.width(), obj.height(), obj.mip_count(), obj.format(),
+                                                 "GX Streaming Texture");
+  }
+  gfx::write_texture(*entry.handle, source);
+  ++s_stats.streamingUpdates;
+  s_stats.uploadBytes += texture_handle_size(entry.handle);
+  return entry.handle;
+}
