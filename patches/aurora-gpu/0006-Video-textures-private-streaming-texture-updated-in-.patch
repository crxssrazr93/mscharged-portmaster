@@ -166,6 +166,27 @@ TextureHandle new_dynamic_texture_2d(uint32_t width, uint32_t height, uint32_t m
   return std::make_shared<TextureRef>(texture, texture, gl::Texture{}, size, glFormat, mips, gxFormat);
 }
 
+TextureHandle new_streaming_texture_2d(uint32_t width, uint32_t height, uint32_t mips, u32 gxFormat,
+                                       const char* label) noexcept {
+  ZoneScopedS(3);
+  clamp_texture_dims(width, height, mips, label);
+  gl::TextureFormat glFormat = to_gl(gxFormat);
+  gl::TexSwizzle swizzle = gl::TexSwizzle::None;
+  if (compact_mode() != CompactMode::Off && glFormat == gl::TextureFormat::RGBA8Unorm) {
+    if (gxFormat == GX_TF_I4 || gxFormat == GX_TF_I8) {
+      glFormat = gl::TextureFormat::R8Unorm, swizzle = gl::TexSwizzle::RRRR;
+    } else if (gxFormat == GX_TF_IA4 || gxFormat == GX_TF_IA8) {
+      glFormat = gl::TextureFormat::RG8Unorm, swizzle = gl::TexSwizzle::RRRG;
+    }
+  }
+  const gl::Extent3D size{.width = width, .height = height, .depthOrArrayLayers = 1};
+  gl::Texture texture =
+      create_gl_texture(glFormat, size, mips, /*renderable=*/false, census_tag_for(gxFormat, false), swizzle);
+  auto handle = std::make_shared<TextureRef>(texture, texture, gl::Texture{}, size, glFormat, mips, gxFormat);
+  handle->streaming = true;
+  return handle;
+}
+
 TextureHandle new_render_texture(uint32_t width, uint32_t height, u32 gxFormat, const char* label) noexcept {
   ZoneScoped;
 
@@ -215,6 +236,25 @@ void write_texture(TextureRef& ref, ArrayRef<uint8_t> data) noexcept {
     }
   }
 
+  // Storage narrower than the RGBA8 decode (streaming textures): keep the channels the swizzle reads.
+  ByteBuffer packed;
+  if (!converted.data.empty() &&
+      (ref.format == gl::TextureFormat::R8Unorm || ref.format == gl::TextureFormat::RG8Unorm)) {
+    const size_t texels = converted.data.size() / 4;
+    const bool two = ref.format == gl::TextureFormat::RG8Unorm;
+    packed = ByteBuffer(texels * (two ? 2 : 1));
+    const uint8_t* src = converted.data.data();
+    for (size_t i = 0; i < texels; ++i) {
+      if (two) {
+        packed.data()[i * 2] = src[i * 4];
+        packed.data()[i * 2 + 1] = src[i * 4 + 3];
+      } else {
+        packed.data()[i] = src[i * 4];
+      }
+    }
+    data = packed;
+  }
+
   uint32_t offset = 0;
   for (uint32_t mip = 0; mip < ref.mipCount; ++mip) {
     const gl::Extent3D mipSize{
