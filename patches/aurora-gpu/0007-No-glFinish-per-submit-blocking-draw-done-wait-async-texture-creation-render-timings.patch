+// GL texture names generated ahead of time on the render worker. Creating a texture used to block the recording thread
+// until the worker had drained its whole queue (every new texture, every video plane, every display copy). With a
+// name in hand the handle is complete, and the worker makes the storage in order before any upload or draw that
+// uses it.
+std::mutex g_textureNameMutex;
+std::vector<gl::GLuint> g_textureNames;
+std::atomic_bool g_textureNameRefillQueued{false};
+constexpr size_t TextureNameLowWater = 24;
+constexpr int TextureNameBatch = 64;
+
+gl::GLuint take_texture_name() {
+  std::lock_guard lock{g_textureNameMutex};
+  if (g_textureNames.empty()) {
+    return 0;
+  }
+  const gl::GLuint id = g_textureNames.back();
+  g_textureNames.pop_back();
+  return id;
+}
+
+void queue_texture_name_refill() {
+  if (g_textureNameRefillQueued.exchange(true)) {
+    return;
+  }
+  render_worker::enqueue_work([] {
+    gl::GLuint names[TextureNameBatch];
+    gl::generate_texture_names(names, TextureNameBatch);
+    {
+      std::lock_guard lock{g_textureNameMutex};
+      g_textureNames.insert(g_textureNames.end(), names, names + TextureNameBatch);
+    }
+    g_textureNameRefillQueued.store(false);
+  });
+}
