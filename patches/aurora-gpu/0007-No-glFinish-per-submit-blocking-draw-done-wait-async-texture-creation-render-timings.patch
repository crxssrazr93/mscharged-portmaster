+// Wall time spent in the stages that decide the frame rate, summed over threads (see the [gl-time] line, shown in
+// ms per second of wall time):
+//   ops        render worker executing recorded ops (uploads and draws, includes `upload`)
+//   upload     render worker texture and buffer uploads
+//   finish     render worker blocked in glFinish
+//   sync-wait  recording thread blocked until the render worker has executed everything (render_worker::synchronize)
+//   drawdone   GX owner thread blocked in GXWaitDrawDone
+//   parse      GX FIFO worker processing commands (includes the sync wait of a draw-done)
+//   pipeline   recording thread blocked on a shader compile
+//   slot-wait  recording thread waiting for a free frame slot (the render worker is two frames behind)
+//   fence-wait render worker waiting for the GPU to release a slot's ring buffers
+//   present    render worker drawing and presenting the VI picture
+enum Timer : uint8_t {
+  TmOps, TmUpload, TmFinish, TmSyncWait, TmDrawDone, TmParse, TmPipeline, TmSlotWait, TmFenceWait, TmPresent, TmCount
+};
+void time_add(Timer timer, int64_t nanoseconds) noexcept;
+struct ScopedTimer {
+  Timer timer;
+  int64_t start;
+  explicit ScopedTimer(Timer t) noexcept;
+  ~ScopedTimer();
+};
