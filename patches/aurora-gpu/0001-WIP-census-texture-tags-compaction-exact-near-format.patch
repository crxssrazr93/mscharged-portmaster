diff --git a/lib/gfx/texture_compact.cpp b/lib/gfx/texture_compact.cpp
new file mode 100644
index 0000000..e120650
--- /dev/null
+++ b/lib/gfx/texture_compact.cpp
@@ -0,0 +1,221 @@
+#include "texture_compact.hpp"
+
+#include "../gl/census.hpp"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+#include <dolphin/gx.h>
+#include <tracy/Tracy.hpp>
+
+namespace aurora::gfx {
+namespace {
+Module Log("aurora::gfx::texture_compact");
+
+std::atomic<int> g_mode{static_cast<int>(CompactMode::Near)};
+
+bool parse_env(CompactMode& out) {
+  const char* env = std::getenv("AURORA_TEXTURE_COMPACT");
+  if (env == nullptr || env[0] == '\0') {
+    return false;
+  }
+  if (!std::strcmp(env, "off") || !std::strcmp(env, "0")) {
+    out = CompactMode::Off;
+  } else if (!std::strcmp(env, "exact")) {
+    out = CompactMode::Exact;
+  } else if (!std::strcmp(env, "near") || !std::strcmp(env, "1")) {
+    out = CompactMode::Near;
+  } else if (!std::strcmp(env, "lossy") || !std::strcmp(env, "2")) {
+    out = CompactMode::Lossy;
+  } else {
+    Log.warn("AURORA_TEXTURE_COMPACT={} not understood (off|exact|near|lossy)", env);
+    return false;
+  }
+  return true;
+}
+
+// Values an n bit channel expands to when widened to 8 bits the way GX does ((c << (8-n)) | (c >> (2n-8))).
+struct Grids {
+  std::array<bool, 256> is4{}, is5{}, is6{};
+  Grids() {
+    for (int v = 0; v < 256; ++v) {
+      is4[v] = (v % 17) == 0;
+      const int c5 = v >> 3;
+      is5[v] = ((c5 << 3) | (c5 >> 2)) == v;
+      const int c6 = v >> 2;
+      is6[v] = ((c6 << 2) | (c6 >> 4)) == v;
+    }
+  }
+};
+const Grids g_grids;
+
+struct Stats {
+  bool gray = true;     // r == g == b
+  bool intensity = true; // gray and a == r
+  bool opaque = true;   // a == 255
+  bool q4 = true;       // every channel (alpha too) is a 4 bit expansion
+  bool q555 = true;     // opaque, every color channel a 5 bit expansion
+  bool q565 = true;     // opaque, r and b 5 bit, g 6 bit expansions
+  [[nodiscard]] bool any() const { return gray || q4 || q555 || q565; }
+};
+
+Stats analyze(const uint8_t* px, size_t count) {
+  Stats s;
+  for (size_t i = 0; i < count; ++i, px += 4) {
+    const uint8_t r = px[0], g = px[1], b = px[2], a = px[3];
+    if (s.gray && (r != g || g != b)) {
+      s.gray = s.intensity = false;
+    }
+    if (s.intensity && a != r) {
+      s.intensity = false;
+    }
+    if (a != 255) {
+      s.opaque = s.q555 = s.q565 = false;
+    }
+    if (s.q4 && !(g_grids.is4[r] && g_grids.is4[g] && g_grids.is4[b] && g_grids.is4[a])) {
+      s.q4 = false;
+    }
+    if (s.q555 && !(g_grids.is5[r] && g_grids.is5[g] && g_grids.is5[b])) {
+      s.q555 = false;
+    }
+    if (s.q565 && !(g_grids.is5[r] && g_grids.is6[g] && g_grids.is5[b])) {
+      s.q565 = false;
+    }
+    // Grey images stay in the running even when they fail the others, so only quit when nothing is left.
+    if (!s.any()) {
+      break;
+    }
+  }
+  return s;
+}
+
+size_t texel_count(uint32_t width, uint32_t height, uint32_t mips) {
+  size_t total = 0;
+  for (uint32_t m = 0; m < mips; ++m) {
+    total += static_cast<size_t>(std::max(width >> m, 1u)) * std::max(height >> m, 1u);
+  }
+  return total;
+}
+} // namespace
+
+CompactMode compact_mode() noexcept {
+  static const bool envChecked = [] {
+    CompactMode m;
+    if (parse_env(m)) {
+      g_mode.store(static_cast<int>(m));
+      Log.info("[texture-compact] AURORA_TEXTURE_COMPACT sets mode {}", static_cast<int>(m));
+    }
+    return true;
+  }();
+  (void)envChecked;
+  return static_cast<CompactMode>(g_mode.load(std::memory_order_relaxed));
+}
+
+void set_compact_mode(CompactMode mode) noexcept {
+  CompactMode env;
+  if (parse_env(env)) {
+    return; // the environment wins
+  }
+  g_mode.store(static_cast<int>(mode));
+}
+
+uint8_t census_tag_for(u32 gxFormat, bool tlut) noexcept {
+  using namespace gl::census;
+  if (tlut) {
+    return TagTlut;
+  }
+  switch (gxFormat) {
+  case GX_TF_I4:
+    return TagI4;
+  case GX_TF_I8:
+    return TagI8;
+  case GX_TF_IA4:
+    return TagIA4;
+  case GX_TF_IA8:
+    return TagIA8;
+  case GX_TF_RGB565:
+    return TagRGB565;
+  case GX_TF_RGB5A3:
+    return TagRGB5A3;
+  case GX_TF_RGBA8:
+    return TagRGBA8;
+  case GX_TF_CMPR:
+    return TagCMPR;
+  case GX_TF_C4:
+    return TagC4;
+  case GX_TF_C8:
+    return TagC8;
+  case GX_TF_C14X2:
+    return TagC14X2;
+  default:
+    return (gxFormat & _GX_TF_PC) != 0 ? TagPC : TagOther;
+  }
+}
+
+CompactedTexture compact_rgba8(uint32_t width, uint32_t height, uint32_t mips, ArrayRef<uint8_t> rgba) {
+  ZoneScoped;
+  CompactedTexture out;
+  const CompactMode mode = compact_mode();
+  const size_t count = texel_count(width, height, mips);
+  if (mode == CompactMode::Off || rgba.size() < count * 4) {
+    return out;
+  }
+  const uint8_t* src = rgba.data();
+  const Stats st = analyze(src, count);
+
+  // Smallest first. 1 byte per texel: grey images; 2 bytes: 4 bit images, grey with alpha, 5/6 bit opaque images.
+  if (st.intensity) {
+    out.format = gl::TextureFormat::R8Unorm;
+    out.swizzle = gl::TexSwizzle::RRRR;
+    out.data = ByteBuffer(count);
+    for (size_t i = 0; i < count; ++i) {
+      out.data.data()[i] = src[i * 4];
+    }
+  } else if (st.gray && st.opaque) {
+    out.format = gl::TextureFormat::R8Unorm;
+    out.swizzle = gl::TexSwizzle::RRR1;
+    out.data = ByteBuffer(count);
+    for (size_t i = 0; i < count; ++i) {
+      out.data.data()[i] = src[i * 4];
+    }
+  } else if (st.gray) {
+    out.format = gl::TextureFormat::RG8Unorm;
+    out.swizzle = gl::TexSwizzle::RRRG;
+    out.data = ByteBuffer(count * 2);
+    for (size_t i = 0; i < count; ++i) {
+      out.data.data()[i * 2] = src[i * 4];
+      out.data.data()[i * 2 + 1] = src[i * 4 + 3];
+    }
+  } else if (st.q4) {
+    out.format = gl::TextureFormat::RGBA4Unorm;
+    out.data = ByteBuffer(count * 2);
+    auto* dst = reinterpret_cast<uint16_t*>(out.data.data());
+    for (size_t i = 0; i < count; ++i) {
+      const uint8_t* p = src + i * 4;
+      dst[i] = static_cast<uint16_t>((p[0] >> 4) << 12 | (p[1] >> 4) << 8 | (p[2] >> 4) << 4 | (p[3] >> 4));
+    }
+  } else if (mode >= CompactMode::Near && st.q555) {
+    out.format = gl::TextureFormat::RGB5A1Unorm;
+    out.data = ByteBuffer(count * 2);
+    auto* dst = reinterpret_cast<uint16_t*>(out.data.data());
+    for (size_t i = 0; i < count; ++i) {
+      const uint8_t* p = src + i * 4;
+      dst[i] = static_cast<uint16_t>((p[0] >> 3) << 11 | (p[1] >> 3) << 6 | (p[2] >> 3) << 1 | 1);
+    }
+  } else if (mode >= CompactMode::Near && st.q565) {
+    out.format = gl::TextureFormat::RGB565Unorm;
+    out.data = ByteBuffer(count * 2);
+    auto* dst = reinterpret_cast<uint16_t*>(out.data.data());
+    for (size_t i = 0; i < count; ++i) {
+      const uint8_t* p = src + i * 4;
+      dst[i] = static_cast<uint16_t>((p[0] >> 3) << 11 | (p[1] >> 2) << 5 | (p[2] >> 3));
+    }
+  }
+  return out;
+}
+
+} // namespace aurora::gfx
diff --git a/lib/gfx/texture_compact.hpp b/lib/gfx/texture_compact.hpp
new file mode 100644
index 0000000..6424f9f
--- /dev/null
+++ b/lib/gfx/texture_compact.hpp
@@ -0,0 +1,36 @@
+#pragma once
+
+#include "texture.hpp"
+#include "../gl/textures.hpp"
+#include "../internal.hpp"
+
+namespace aurora::gfx {
+
+// How decoded GX textures are stored on the GPU. Every mode but Off keeps the sampled colors identical
+// to the RGBA8 decode, except where noted.
+enum class CompactMode : uint8_t {
+  Off,   // always RGBA8 (the reference behavior)
+  Exact, // R8/RG8 with a swizzle for grey images, RGBA4 for 4 bit images: bit exact
+  Near,  // plus RGB5_A1/RGB565 for opaque 5/6 bit images: sampled value within 1/255 of the RGBA8 decode
+  Lossy, // plus ETC2 for what is left (compressed GX textures and photographic RGBA8)
+};
+
+// AURORA_TEXTURE_COMPACT=off|exact|near|lossy overrides the default (read once). set_compact_mode() is the
+// programmatic setting (honored unless the environment variable is present).
+CompactMode compact_mode() noexcept;
