+// Bump-allocate `length` bytes from a persistent cache buffer and upload the data on the render
+// worker (FIFO-ordered after prior ops, so it never races a prior frame's reads of older contents).
+static std::pair<Range, bool> push_native_cached(const gl::Buffer& buffer, uint32_t& cursor, uint64_t limit,
+                                                 const uint8_t* data, size_t length) {
+  // The persistent native-geometry GL cache buffers are created on the worker in initialize(). If
+  // they do not exist the caller falls back to the per-frame ring (e.g. the pre-init window).
+  if (!buffer) {
+    return {{}, false};
+  }
+  const uint32_t offset = static_cast<uint32_t>(AURORA_ALIGN(cursor, 4));
+  const size_t alignedSize = AURORA_ALIGN(length, 4);
+  if (static_cast<uint64_t>(offset) + alignedSize > limit) {
+    return {{}, false};
+  }
+  // The GL upload must run on the render worker (it owns the context). The copy keeps the data alive
+  // until the worker executes the glBufferSubData.
+  std::vector<uint8_t> copy(alignedSize);
+  std::memcpy(copy.data(), data, length);
+  render_worker::enqueue_work([buffer, offset, copy = std::move(copy)] {
+    gl::upload_buffer(buffer, offset, copy.data(), copy.size());
+  });
+  cursor = offset + static_cast<uint32_t>(alignedSize);
+  return {Range{offset, static_cast<uint32_t>(length)}, true};
