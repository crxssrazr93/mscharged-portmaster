-    return;
-  }
-  start_worker_pool();
-  std::lock_guard lock{s_jobMutex};
-  if (!s_pendingThumbnailLoads.insert(entry.id).second) {
-    return;
-  }
-  s_lowPriorityJobs.push_back({.tier = Tier::Thumbnail, .entry = entry});
-  s_jobCv.notify_one();
-}
