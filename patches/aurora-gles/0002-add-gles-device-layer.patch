index 0000000000000000000000000000000000000000..4e8c2b0e4cccbbac7d6e93c8ae6688f89e370622
--- /dev/null
+++ b/lib/gl/trace.cpp
@@ -0,0 +1,36 @@
+#include "trace.hpp"
+
+#include "../internal.hpp"
+
+#include <atomic>
+#include <cstdio>
+#include <chrono>
+
+namespace aurora::gl::trace {
+
+bool report_due() noexcept {
+  if (!enabled()) {
+    return false;
+  }
+  static std::atomic<int64_t> last{0};
+  const int64_t now = std::chrono::duration_cast<std::chrono::milliseconds>(
+                          std::chrono::steady_clock::now().time_since_epoch()).count();
+  int64_t previous = last.load();
+  return now - previous >= 1000 && last.compare_exchange_strong(previous, now);
+}
+
+void report() {
+  // stderr, not the buffered log file, so the counters survive a killed process.
+  std::fprintf(stderr,
+               "[gl-trace] draws executed=%llu skipped(no pipeline)=%llu passes=%llu passes with draws=%llu "
+               "xfb encodes=%llu efb resolves=%llu shader failures=%llu hardware submits=%llu\n",
+               static_cast<unsigned long long>(counter(DrawsExecuted).load()),
+               static_cast<unsigned long long>(counter(DrawsSkippedNoPipeline).load()),
+               static_cast<unsigned long long>(counter(Passes).load()),
+               static_cast<unsigned long long>(counter(PassesWithDraws).load()),
+               static_cast<unsigned long long>(counter(XfbEncodes).load()),
+               static_cast<unsigned long long>(counter(EfbResolves).load()),
+               static_cast<unsigned long long>(counter(ShaderFailures).load()),
+               static_cast<unsigned long long>(counter(HardwareSubmits).load()));
+}
+} // namespace aurora::gl::trace
diff --git a/lib/gl/trace.hpp b/lib/gl/trace.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..c83bd5f386f44f366b44099ee4e8248143e9642a
--- /dev/null
+++ b/lib/gl/trace.hpp
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+
+namespace aurora::gl::trace {
+// AURORA_GL_TRACE=1 collects a few renderer counters and logs them about once a second from the render
+// worker (development aid, off by default).
+enum Counter : uint32_t {
+  DrawsExecuted,
+  DrawsSkippedNoPipeline,
+  Passes,
+  PassesWithDraws,
+  XfbEncodes,
+  EfbResolves,
+  ShaderFailures,
+  HardwareSubmits,
+  CounterCount,
+};
+
+inline bool enabled() noexcept {
+  static const bool value = [] {
+    const char* env = std::getenv("AURORA_GL_TRACE");
+    return env != nullptr && *env != '\0' && *env != '0';
+  }();
+  return value;
+}
+
+inline std::atomic<uint64_t>& counter(Counter c) noexcept {
+  static std::atomic<uint64_t> counters[CounterCount];
+  return counters[c];
+}
+
+// Logs and returns true when at least a second passed since the last report.
+bool report_due() noexcept;
+void report();
+
+inline void bump(Counter c) noexcept {
+  if (enabled()) {
+    counter(c).fetch_add(1, std::memory_order_relaxed);
+    if (report_due()) {
+      report();
+    }
+  }
+}
+} // namespace aurora::gl::trace
