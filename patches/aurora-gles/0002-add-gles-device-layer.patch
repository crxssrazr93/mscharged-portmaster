+using GLintptr = intptr_t;
+using GLsizeiptr = intptr_t;
+using GLint64 = int64_t;
+using GLuint64 = uint64_t;
+using GLsync = void*; // opaque; we never dereference
+
+using EGLDisplay = void*;
