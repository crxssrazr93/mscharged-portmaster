diff --git a/include/aurora/gl.hpp b/include/aurora/gl.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..0eed668778663f0e3bec395d192cf4ddd60116a4
--- /dev/null
+++ b/include/aurora/gl.hpp
@@ -0,0 +1,35 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+// Small public GL helpers for host applications. They hide the render worker
+// thread (which owns the GL context) so a host never needs GL headers or entry
+// points. Every function is callable from the host/game thread; the readback
+// helpers may also be called from inside an encoder task or draw callback (which
+// already runs on the render worker), in which case they execute inline.
+namespace aurora::gl_public {
+
+/// Blocks until all GPU work submitted so far has completed (glFinish on the
+/// render worker, after draining the worker queue). Pumps hardware interrupts
+/// while waiting, like aurora::gfx::synchronize(). Do not call with an open
+/// host frame. Returns immediately if GX is not initialized.
+void finish_gpu();
+
+/// Reads a rectangle of an RGBA8 GL texture (such as ResolvedTargets::color or an
+/// XFB snapshot texture) into `out` as tightly packed RGBA bytes, width * height * 4.
+/// Render target textures are stored GL native (row 0 is the bottom row). With
+/// `topDown` the rectangle is given in top left origin coordinates (which needs
+/// `textureHeight`, the full height of the texture) and the rows of `out` are
+/// returned top row first, matching how the game views the image. Without it,
+/// (x, y) is the bottom left origin and row 0 of `out` is the bottom row;
+/// `textureHeight` is then ignored.
+/// `outBytes` must be at least width * height * 4. Returns false (with a warning)
+/// on any failure; `out` is then unspecified.
+///
+/// Textures from aurora::gfx::resolve_pass are valid only for the current frame:
+/// read them from an encoder task, or before the frame ends.
+bool read_texture_rgba8(uint32_t glTexture, uint32_t textureHeight, uint32_t x, uint32_t y, uint32_t width,
+                        uint32_t height, uint8_t* out, size_t outBytes, bool topDown = true);
+
+} // namespace aurora::gl_public
