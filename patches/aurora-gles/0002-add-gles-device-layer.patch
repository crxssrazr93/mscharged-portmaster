+inline constexpr GLenum GL_TEXTURE_WRAP_R = 0x8072;
+inline constexpr GLenum GL_TEXTURE_MIN_LOD = 0x813A;
+inline constexpr GLenum GL_TEXTURE_MAX_LOD = 0x813B;
