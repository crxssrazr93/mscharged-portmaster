-static bool cache_init() {
-  if (cache_broken) {
-    return false;
-  }
-
-  if (db) {
-    return true;
-  }
-
-  if (!cache_init_core()) {
-    Log.error("SQLite DB init failed");
-    init_abort();
-    return false;
-  }
-
-  Log.debug("SQLite cache init succeeded");
-
-  return true;
-}
