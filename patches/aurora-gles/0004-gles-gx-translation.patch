+// A native-expanded vertex projected to clip space, with its clip->model displacement map.
+struct ProjectedVertex {
+  const u8* record = nullptr;
+  std::array<float, 3> pos{};
+  std::array<double, 4> clip{};
+  Mat4d inverse{};
+  bool valid = false;
+};
+
+void project_native_vertex(const NativeLayout& layout, const u8* record, const Mat4x4<float>& projection,
+                           ProjectedVertex& out) noexcept {
+  out.record = record;
+  out.valid = false;
+  std::memcpy(out.pos.data(), record + layout.attrs[GX_VA_POS].offset, sizeof(float) * 3);
+  u32 matrix = g_gxState.currentPnMtx;
+  if (layout.attrs[GX_VA_PNMTXIDX].attrType != GX_NONE) {
+    std::memcpy(&matrix, record + layout.attrs[GX_VA_PNMTXIDX].offset, sizeof(u32));
+  }
+  if (matrix >= MaxPnMtx + MaxTexMtx) {
+    return;
+  }
+  const auto& model = matrix < MaxPnMtx ? g_gxState.pnMtx[matrix].pos : g_gxState.texMtxs[matrix - MaxPnMtx];
+  const std::array<Vec4<float>, 4> view{model.m0, model.m1, model.m2, Vec4<float>{0.f, 0.f, 0.f, 1.f}};
+  const std::array<Vec4<float>, 4> proj{projection.m0, projection.m1, projection.m2, projection.m3};
+  Mat4d total{};
+  for (int r = 0; r < 4; ++r) {
+    for (int c = 0; c < 4; ++c) {
+      double sum = 0.0;
+      for (int k = 0; k < 4; ++k) {
+        sum += static_cast<double>(proj[r][k]) * static_cast<double>(view[k][c]);
+      }
+      total[r * 4 + c] = sum;
+    }
+  }
+  for (int r = 0; r < 4; ++r) {
+    out.clip[r] = total[r * 4 + 0] * out.pos[0] + total[r * 4 + 1] * out.pos[1] + total[r * 4 + 2] * out.pos[2] +
+                  total[r * 4 + 3];
+  }
+  out.valid = std::isfinite(out.clip[3]) && out.clip[3] > 1e-6 && invert4(total, out.inverse);
+}
