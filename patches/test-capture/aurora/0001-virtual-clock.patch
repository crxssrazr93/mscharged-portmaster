+                                static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(caller[3])),
+                                static_cast<unsigned long long>(count));
+    if (n < 0 || static_cast<std::size_t>(n) >= capacity - used) break;
+    used += static_cast<std::size_t>(n);
