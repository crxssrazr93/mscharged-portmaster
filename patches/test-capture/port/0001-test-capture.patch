--- /dev/null
+++ b/src/testcapture/test_capture.h
@@ -0,0 +1,20 @@
+// Test only (patches/test-capture): deterministic virtual time, scripted input by game frame
+// number and in-process capture of the presented picture. Compiled only with MSCHARGED_TEST_CAPTURE.
+#pragma once
+#include <SDL3/SDL.h>
+#include <array>
+#include <cstdint>
+
+namespace mscharged::testcap {
+bool VirtualTime();                       // CAPTURE_VTIME=1
+std::uint64_t NowNs();                    // virtual ns, or SDL ticks
+// Called by the main loop around each game frame (frame numbers start at 0).
+void BeforeFrame(unsigned frame);
+// Returns true when the run is finished and the process should stop.
+bool AfterFrame(unsigned frame);
+unsigned CurrentFrame();
+// Scripted desktop input: overrides the raw state read by the desktop WPAD service.
+bool InputActive();
+void InputState(std::array<bool, SDL_SCANCODE_COUNT>& keys, float& mouse_x, float& mouse_y,
+                std::uint32_t& mouse_buttons);
+}
--- /dev/null
+++ b/src/testcapture/test_capture.cpp
@@ -0,0 +1,127 @@
+#include "testcapture/test_capture.h"
+#include <aurora/time.hpp>
+#include <aurora/video.h>
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <set>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace mscharged::testcap {
+namespace {
+struct Config {
+    bool vtime = false;
+    std::string dir;
+    std::set<unsigned> frames;
+    unsigned exit_after = 0;       // 0: after the last capture + 30 frames
+    bool input = false;
+    bool trace = false;
+};
+struct Event { unsigned frame; std::string op; float a, b; std::string key; };
+std::vector<Event> g_events;
+size_t g_next_event = 0;
+std::array<bool, SDL_SCANCODE_COUNT> g_keys{};
+float g_mx = 0, g_my = 0;
+std::uint32_t g_buttons = 0;
+std::atomic<unsigned> g_frame{0};
+Config g_cfg;
+FILE* g_trace = nullptr;
+unsigned g_last_capture = 0;
+
+Config Load() {
+    Config c;
+    const char* v = std::getenv("CAPTURE_VTIME");
+    c.vtime = v && *v && *v != '0';
+    if (const char* d = std::getenv("CAPTURE_DIR")) c.dir = d;
+    if (const char* f = std::getenv("CAPTURE_FRAMES")) {
+        // "10,20,100-200/10"
+        std::stringstream list(f); std::string item;
+        while (std::getline(list, item, ',')) {
+            unsigned a = 0, b = 0, s = 1;
+            if (std::sscanf(item.c_str(), "%u-%u/%u", &a, &b, &s) == 3 || std::sscanf(item.c_str(), "%u-%u", &a, &b) == 2) {
+                for (unsigned n = a; n <= b; n += std::max(1u, s)) c.frames.insert(n);
+            } else if (std::sscanf(item.c_str(), "%u", &a) == 1) c.frames.insert(a);
+        }
+    }
+    if (const char* e = std::getenv("CAPTURE_EXIT_FRAME")) c.exit_after = unsigned(std::atoi(e));
+    c.trace = std::getenv("CAPTURE_TRACE") != nullptr;
+    if (const char* in = std::getenv("CAPTURE_INPUT")) {
+        std::ifstream file(in); std::string line;
+        while (std::getline(file, line)) {
+            if (line.empty() || line[0] == '#') continue;
+            std::stringstream ss(line); Event ev{}; ss >> ev.frame >> ev.op;
+            if (ev.op == "keydown" || ev.op == "keyup") ss >> ev.key;
+            else if (ev.op == "mouse") ss >> ev.a >> ev.b;
+            else if (ev.op == "mdown" || ev.op == "mup") ss >> ev.key;
+            g_events.push_back(ev);
+        }
+        std::stable_sort(g_events.begin(), g_events.end(), [](auto& x, auto& y) { return x.frame < y.frame; });
+        c.input = true;
+    }
+    return c;
+}
+// Static initialisation enables the virtual clock before Aurora creates any clock anchor.
+struct Init {
+    Init() {
+        g_cfg = Load();
+        if (g_cfg.vtime) aurora::time::vclock::enable();
+        if (!g_cfg.dir.empty()) std::filesystem::create_directories(g_cfg.dir);
+        if (g_cfg.trace && !g_cfg.dir.empty()) g_trace = std::fopen((g_cfg.dir + "/trace.txt").c_str(), "w");
+        if (!g_cfg.frames.empty()) g_last_capture = *g_cfg.frames.rbegin();
+    }
+} g_init;
+}
+
+bool VirtualTime() { return g_cfg.vtime; }
+std::uint64_t NowNs() { return g_cfg.vtime ? std::uint64_t(aurora::time::vclock::ns()) : SDL_GetTicksNS(); }
+unsigned CurrentFrame() { return g_frame.load(); }
+bool InputActive() { return g_cfg.input; }
+void InputState(std::array<bool, SDL_SCANCODE_COUNT>& keys, float& mx, float& my, std::uint32_t& buttons) {
+    keys = g_keys; mx = g_mx; my = g_my; buttons = g_buttons;
+}
+
+void BeforeFrame(unsigned frame) {
+    g_frame = frame;
+    if (frame == 3 && !g_cfg.dir.empty()) {
+        std::ifstream in("/proc/self/maps"); std::ofstream out(g_cfg.dir + "/maps.txt"); out << in.rdbuf();
+    }
+    while (g_next_event < g_events.size() && g_events[g_next_event].frame <= frame) {
+        const auto& e = g_events[g_next_event++];
+        if (e.op == "keydown" || e.op == "keyup") {
+            const SDL_Scancode code = SDL_GetScancodeFromName(e.key.c_str());
+            if (code != SDL_SCANCODE_UNKNOWN) g_keys[code] = e.op == "keydown";
+            else std::fprintf(stderr, "testcap: unknown key %s\n", e.key.c_str());
+        } else if (e.op == "mouse") { g_mx = e.a; g_my = e.b; }
+        else if (e.op == "mdown" || e.op == "mup") {
+            const std::uint32_t bit = e.key == "right" ? SDL_BUTTON_RMASK : SDL_BUTTON_LMASK;
+            g_buttons = e.op == "mdown" ? (g_buttons | bit) : (g_buttons & ~bit);
+        }
+    }
+    if (g_cfg.frames.count(frame) && !g_cfg.dir.empty()) {
+        char name[64]; std::snprintf(name, sizeof name, "/f%06u.png", frame);
+        const std::string path = g_cfg.dir + name;
+        if (!aurora_request_video_screenshot(path.c_str())) std::fprintf(stderr, "testcap: screenshot busy at %u\n", frame);
+    }
+}
+
+bool AfterFrame(unsigned frame) {
+    if (g_trace) {
+        AuroraVIHardwareState vi{};
+        aurora_get_video_hardware_state(&vi);
+        std::fprintf(g_trace, "%u %lld %u\n", frame, (long long)aurora::time::vclock::ns(), vi.retrace_count);
+        if (std::getenv("CAPTURE_TRACE")[0] == '2') {
+            static char buffer[8192];
+            const auto n = aurora::time::vclock::dump_queries(buffer, sizeof buffer);
+            std::fprintf(g_trace, "Q%.*s\n", int(n), buffer);
+        }
+        if (frame % 16 == 0) std::fflush(g_trace);
+    }
+    const unsigned limit = g_cfg.exit_after ? g_cfg.exit_after : (g_last_capture ? g_last_capture + 30 : 0);
+    return limit && frame >= limit;
+}
+}
